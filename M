local isDraggingBtn = false
local btnDragStartPos = nil
local btnInputStart = nil

openBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingBtn = true
        btnDragStartPos = openBtn.Position
        btnInputStart = input.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDraggingBtn = false
                local px = openBtn.Position.X.Scale
                local py = openBtn.Position.Y.Scale
                if px < 0 or px > (1 - openBtn.Size.X.Scale) then
                    local newX = math.clamp(px, 0, 1 - openBtn.Size.X.Scale)
                    tweenService:Create(openBtn, TweenInfo.new(0.3), {Position = UDim2.new(newX, 0, py, 0)}):Play()
                end
                if py < 0 or py > (1 - openBtn.Size.Y.Scale) then
                    local newY = math.clamp(py, 0, 1 - openBtn.Size.Y.Scale)
                    tweenService:Create(openBtn, TweenInfo.new(0.3), {Position = UDim2.new(openBtn.Position.X.Scale, 0, newY, 0)}):Play()
                end
            end
        end)
    end
end)

uis.InputChanged:Connect(function(input)
    if isDraggingBtn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaX = input.Position.X - btnInputStart.X
        local deltaY = input.Position.Y - btnInputStart.Y
        local viewSize = workspace.CurrentCamera.ViewportSize
        local scaleDeltaX = deltaX / viewSize.X
        local scaleDeltaY = deltaY / viewSize.Y
        openBtn.Position = UDim2.new(
            btnDragStartPos.X.Scale + scaleDeltaX, 0,
            btnDragStartPos.Y.Scale + scaleDeltaY, 0
        )
    end
end)

