    local tw = tweenService:Create(prog, TweenInfo.new(3, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 1, 0)})
    tw:Play()
    tw.Completed:Connect(function()
        local outTw = tweenService:Create(f, TweenInfo.new(0.3), {Position = UDim2.new(1.2, 0, f.Position.Y.Scale, 0)})
        outTw:Play()
        outTw.Completed:Connect(function()
            for k, v in ipairs(notifications) do
                if v == f then table.remove(notifications, k) break end
            end
            f:Destroy()
        end)
    end)
end

