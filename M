local isDraggingMenu = false
local menuDragStartPos = nil
local menuInputStart = nil

menu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local absPos = menu.AbsolutePosition
        local absSize = menu.AbsoluteSize
        local mPos = input.Position
        local cornerSizeX = absSize.X * 0.15
        local cornerSizeY = absSize.Y * 0.15
        
        local inLeft = mPos.X < absPos.X + cornerSizeX
        local inRight = mPos.X > absPos.X + absSize.X - cornerSizeX
        local inTop = mPos.Y < absPos.Y + cornerSizeY
        local inBottom = mPos.Y > absPos.Y + absSize.Y - cornerSizeY
        
        if (inLeft and inTop) or (inLeft and inBottom) or (inRight and inTop) or (inRight and inBottom) then
            isDraggingMenu = true
            menuDragStartPos = menu.Position
            menuInputStart = input.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDraggingMenu = false
                    local px = menu.Position.X.Scale
                    local sx = menu.Size.X.Scale
                    local py = menu.Position.Y.Scale
                    local sy = menu.Size.Y.Scale
                    
                    if px + sx < 0 then
                        tweenService:Create(menu, TweenInfo.new(0.3), {Position = UDim2.new(0, 0, py, 0)}):Play()
                    elseif px > 1 then
                        tweenService:Create(menu, TweenInfo.new(0.3), {Position = UDim2.new(1 - sx, 0, py, 0)}):Play()
                    end
                end
            end)
        end
    end
end)

uis.InputChanged:Connect(function(input)
    if isDraggingMenu and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaX = input.Position.X - menuInputStart.X
        local deltaY = input.Position.Y - menuInputStart.Y
        local viewSize = workspace.CurrentCamera.ViewportSize
        local scaleDeltaX = deltaX / viewSize.X
        local scaleDeltaY = deltaY / viewSize.Y
        menu.Position = UDim2.new(
            menuDragStartPos.X.Scale + scaleDeltaX, 0,
            menuDragStartPos.Y.Scale + scaleDeltaY, 0
        )
    end
end)
