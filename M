local allOptions = {}
local activeTabName = "Main"
local totalContentItems = 0

local function updateContentScrolling()
    if totalContentItems >= 7 then
        contentArea.ScrollingEnabled = true
        contentArea.CanvasSize = UDim2.new(0, 0, totalContentItems * 0.15, 0)
    else
        contentArea.ScrollingEnabled = false
        contentArea.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
end

searchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local q = searchInput.Text:lower()
    if q == "" then
        clearSearchBtn.Visible = false
        for _, opt in ipairs(allOptions) do
            opt.UI.Visible = (opt.Tab == activeTabName and opt.Category.IsOpen)
        end
        totalContentItems = 0
        for _, opt in ipairs(allOptions) do
            if opt.IsCategory and opt.Tab == activeTabName then
                opt.UI.Visible = true
                opt.UI.Position = UDim2.new(0, 0, totalContentItems * 0.15, 0)
                totalContentItems = totalContentItems + 1
                if opt.IsOpen then
                    for _, subOpt in ipairs(opt.Children) do
                        subOpt.UI.Visible = true
                        subOpt.UI.Position = UDim2.new(0, 0, totalContentItems * 0.15, 0)
                        totalContentItems = totalContentItems + 1
                    end
                end
            elseif opt.IsCategory then
                opt.UI.Visible = false
            end
        end
        updateContentScrolling()
    else
        clearSearchBtn.Visible = true
        totalContentItems = 0
        for _, opt in ipairs(allOptions) do
            if opt.IsCategory then
                opt.UI.Visible = false
            else
                if opt.Title:lower():find(q) then
                    opt.UI.Visible = true
                    opt.UI.Position = UDim2.new(0, 0, totalContentItems * 0.15, 0)
                    totalContentItems = totalContentItems + 1
                else
                    opt.UI.Visible = false
                end
            end
        end
        updateContentScrolling()
    end
end)

local function refreshLayout()
    if searchInput.Text ~= "" then return end
    totalContentItems = 0
    for _, opt in ipairs(allOptions) do
        if opt.IsCategory then
            if opt.Tab == activeTabName then
                opt.UI.Visible = true
                opt.UI.Position = UDim2.new(0, 0, totalContentItems * 0.15, 0)
                totalContentItems = totalContentItems + 1
                if opt.IsOpen then
                    for _, subOpt in ipairs(opt.Children) do
                        subOpt.UI.Visible = true
                        subOpt.UI.Position = UDim2.new(0, 0, totalContentItems * 0.15, 0)
                        totalContentItems = totalContentItems + 1
                    end
                else
                    for _, subOpt in ipairs(opt.Children) do
                        subOpt.UI.Visible = false
                    end
                end
            else
                opt.UI.Visible = false
                for _, subOpt in ipairs(opt.Children) do
                    subOpt.UI.Visible = false
                end
            end
        end
    end
    updateContentScrolling()
end

